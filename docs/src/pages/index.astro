---
// The landing page, outside Starlight: a hero drawn live by zil's own art builtins, a few one-liners, and how to install.
import "../theme.css";
import { encode, highlight } from "../lib/client.js";

const about = "A terse calculator and scripting language for units, dates and much more.";
const fonts = "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap";
const examples = [
  ["units combine and convert", "100 km / 2 h to mph", "31.0686 mph"],
  ["4th Thursday of November", 'date(2026, 11, 1).nth_weekday(4, "thu")', "2026-11-26"],
  ["cups to grams", '1 cup * density("flour") to g', "125.392 g"],
  ["exact decimals", "0.1 + 0.2 == 0.3", "true"],
  ["factoring big ints", "factors(2 ** 32 + 1)", "[641, 6700417]"],
  ["geography", 'great_circle("Paris", "Tokyo")', "9712.52 km"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>zil</title>
    <meta name="description" content={about} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <script is:inline>
      // The sandbox used to live at the root: send its shared links there.
      if (/^#(code=|repl$)/.test(location.hash)) location.replace(`/play/${location.hash}`);
      // Starlight's theme choice, so the landing page matches the docs.
      let t = null;
      try { t = localStorage.getItem("starlight-theme"); } catch {}
      if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
      document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <header class="hero">
      <pre class="sky" aria-hidden="true"></pre>
      <nav>
        <span class="links">
          <a href="/docs/">Docs</a>
          <a href="/play/">Sandbox</a>
          <a href="https://github.com/zanbowie138/zil">GitHub</a>
        </span>
      </nav>
      <div class="pitch">
        <h1 class="mark">zil</h1>
        <p>{about}</p>
        <p class="go"><a class="btn primary" href="/play/">Open the sandbox</a> <a class="btn" href="/docs/">Read the docs</a></p>
      </div>
      <button class="credit" title="Draw the next scene" hidden>↻ <code></code></button>
    </header>

    <main>
      <section>
        <h2>a taste</h2>
        <ul class="taste">
          {
            examples.map(([label, src, result]) => (
              <li>
                <a href={`/play/#code=${encode(src)}`} title="Open in the sandbox">
                  <span class="label">{label}</span>
                  <code set:html={highlight(src)} />
                  <span class="result">→ {result}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="more"><a href="/docs/">Every module, with runnable examples →</a></p>
      </section>

      <section>
        <h2>get it</h2>
        <pre class="install"><span class="hljs-comment"># with Cargo</span>
cargo install zil-cli
<span class="hljs-comment"># then</span>
zil                 <span class="hljs-comment"># the REPL</span>
zil -e "5 ft to cm" <span class="hljs-comment"># one answer</span></pre>
        <p>
          Or download a binary for Windows, macOS or Linux from the <a href="https://github.com/zanbowie138/zil/releases/latest">latest release</a>. No
          install needed to try it: the <a href="/play/">sandbox</a> runs zil in your browser.
        </p>
      </section>
    </main>

    <footer><a href="https://github.com/zanbowie138/zil">github.com/zanbowie138/zil</a></footer>

    <script>
      import { call } from "../lib/client.js";

      const sky = document.querySelector(".sky");
      const credit = document.querySelector(".credit");
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const pick = (xs) => xs[Math.floor(Math.random() * xs.length)];
      const seed = () => Math.floor(Math.random() * 10000);

      // The hero's scenes, each drawn by zil for a w×h grid of characters. `place` art sits at its own size to the right of the
      // pitch; the rest fill the hero. `reveal` is how it appears: "cells" at random, "rows" top down, "flood" outward from the
      // maze's entrance, "frames" played in order (zil prints them split by ~ lines).
      const scenes = [
        { reveal: "cells", zil: (w, h) => `starfield(${w}, ${h}, ${seed()})` },
        { reveal: "rows", place: true, zil: (w, h) => `mandelbrot(${Math.min(w, h * 3)}, ${Math.min(h, Math.round(w / 3))})` },
        { reveal: "rows", place: true, braille: true, zil: (w, h) => `fractal("${pick(["dragon", "koch", "hilbert", "levy", "gosper", "tree", "fern", "bush"])}", ${pick([5, 6])}, ${Math.min(w, h * 2)})` },
        {
          reveal: "frames",
          label: (w, h, s) => `seed(${s}); life(soup(${w}, ${h}), k, true)`,
          zil: (w, h, s) => `seed(${s})
g = (0..${h}).map(|_| (0..${w}).map(|_| if rand() < 0.3 { "#" } else { "." }).join("")).join("\\n")
for k in 0..48 { print(g.replace(".", " ").replace("#", "•")); print("~"); g = life(g, 1, true) }`,
        },
        { reveal: "flood", zil: (w, h, s) => `seed(${s}); maze(${Math.min(200, Math.max(1, (w / 2 - 1) >> 1))}, ${Math.min(200, Math.max(1, (h - 1) >> 1))})` },
        { reveal: "rows", place: true, zil: () => `clipart("${pick(["cat", "owl", "bunny", "fish", "duck", "bat", "snail", "crab", "ghost", "coffee", "rocket", "cactus"])}")` },
        { reveal: "rows", place: true, zil: () => `segments("${new Date().toLocaleDateString("sv")}")` },
      ];
      let current = Math.floor(Math.random() * scenes.length);
      let run = 0;

      const escape = (s) => s.replace(/[&<>]/g, (c) => `&#${c.charCodeAt(0)};`).replace(/✦/g, "<b>✦</b>");

      // When each character of the art shows, from 0 to 1.
      function times(grid, reveal) {
        if (reveal === "cells") return grid.map((row) => row.map((c) => (c === " " ? 0 : Math.random())));
        if (reveal === "rows") return grid.map((row, y) => row.map(() => y / grid.length));
        // flood: walk the maze's passages from the entrance; a wall shows with the first passage beside it.
        const dist = grid.map((row) => row.map(() => Infinity));
        const x0 = grid[0]?.indexOf(" ") ?? -1;
        const queue = x0 < 0 ? [] : [[x0, 0]];
        if (x0 >= 0) dist[0][x0] = 0;
        for (let i = 0; i < queue.length; i++) {
          const [x, y] = queue[i];
          for (const [nx, ny] of [[x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]]) {
            if (grid[ny]?.[nx] === " " && dist[ny][nx] === Infinity) {
              dist[ny][nx] = dist[y][x] + 1;
              queue.push([nx, ny]);
            }
          }
        }
        const max = queue.length ? dist[queue.at(-1)[1]][queue.at(-1)[0]] + 1 : 1;
        const near = (x, y) => Math.min(...[[x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]].map(([nx, ny]) => dist[ny]?.[nx] ?? Infinity));
        return grid.map((row, y) => row.map((c, x) => Math.min(1, (c === " " ? dist[y][x] : near(x, y) + 1) / max)));
      }

      // A character's size: braille can come from a fallback font, wider than the rest.
      function measure(c) {
        const probe = document.createElement("span");
        probe.textContent = c.repeat(10);
        sky.append(probe);
        const { width, height } = probe.getBoundingClientRect();
        probe.remove();
        return [width / 10, height];
      }
      const isBraille = (c) => c >= "⠀" && c <= "⣿";

      // Measure a character, ask zil for the current scene at the hero's size, then reveal it.
      async function draw() {
        const id = ++run;
        const scene = scenes[current];
        const [cw, height] = measure("0");
        const charW = scene.braille ? measure("⠀")[0] : cw;
        const w = Math.min(1000, Math.ceil(sky.clientWidth / charW));
        const h = Math.min(1000, Math.ceil(sky.clientHeight / height));
        const s = seed();
        const src = scene.zil(w, h, s);
        let text;
        try {
          const rows = JSON.parse(await call("notebook", scene.reveal === "frames" ? src : `print(${src})`));
          text = rows.at(-1)[1];
          if (text.startsWith("error:")) throw text;
        } catch {
          // No wasm, no art: the page still reads fine without it.
          return;
        }
        if (id !== run) return;
        credit.querySelector("code").textContent = scene.label?.(w, h, s) ?? src;
        credit.hidden = false;
        sky.classList.add("lit");

        if (scene.reveal === "frames") {
          const frames = text.split(/\n?~\n?/).filter(Boolean);
          if (still) return (sky.innerHTML = escape(frames.at(-1)));
          for (const f of frames) {
            if (id !== run) return;
            sky.innerHTML = escape(f);
            await new Promise((r) => setTimeout(r, 110));
          }
          return;
        }

        // Braille gaps as blank braille, not spaces, so every row is the same width when the font's braille isn't.
        let lines = text.split("\n").map((l) => (scene.braille ? l.replace(/ /g, "⠀") : l));
        if (scene.place) {
          // To the right of the pitch, or centered when the hero is too narrow for both; padded with spaces.
          const free = sky.clientWidth - Math.max(...lines.map((l) => [...l].length)) * charW;
          const x = Math.round((sky.clientWidth < 760 ? free / 2 : free - sky.clientWidth * 0.06) / cw);
          const y = (h - lines.length) >> 1;
          lines = [...Array(Math.max(0, y)).fill(""), ...lines.map((l) => " ".repeat(Math.max(0, x)) + l)];
        }
        const grid = lines.map((l) => [...l]);
        if (still) return (sky.innerHTML = escape(lines.join("\n")));
        const at = times(grid, scene.reveal);
        const start = performance.now();
        const frame = (now) => {
          if (id !== run) return;
          const t = (now - start) / 1400;
          sky.innerHTML = escape(grid.map((row, y) => row.map((c, x) => (at[y][x] <= t ? c : isBraille(c) ? "⠀" : " ")).join("")).join("\n"));
          if (t < 1) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }
      credit.addEventListener("click", () => {
        current = (current + 1) % scenes.length;
        draw();
      });
      draw();
    </script>
  </body>
</html>

<style>
  body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.6 var(--sans); }
  a { color: var(--accent); }

  .mark { font-family: var(--mono); font-weight: 600; letter-spacing: -0.03em; color: var(--ink); text-decoration: none; }
  .mark::after { content: ""; display: inline-block; width: 0.22em; height: 0.22em; margin-left: 0.06em; border-radius: 0.06em; background: var(--accent); }

  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .sky {
    position: absolute; inset: 0; margin: 0; font: 14px/1.25 var(--term); color: var(--muted); white-space: pre; overflow: hidden;
    opacity: 0; transition: opacity 1.2s ease; pointer-events: none;
    /* fade toward the pitch, so the text stays readable over the stars */
    mask-image: radial-gradient(ellipse 60% 55% at 28% 55%, transparent 0%, #000 75%);
  }
  .sky.lit { opacity: 0.55; }
  .sky :global(b) { font-weight: normal; color: var(--accent); }

  nav { position: relative; display: flex; align-items: center; justify-content: flex-end; gap: 16px; padding: 18px clamp(16px, 5vw, 56px); }
  .links { display: flex; gap: clamp(14px, 3vw, 28px); font-size: 15px; font-weight: 500; }
  .links a { color: var(--muted); text-decoration: none; }
  .links a:hover { color: var(--ink); }

  .pitch { position: relative; padding: clamp(24px, 6vw, 56px) clamp(16px, 8vw, 120px) 64px; max-width: 640px; }
  .pitch h1 { margin: 0; font-size: clamp(3.5rem, 12vw, 6.5rem); font-weight: 500; line-height: 1; }
  /* the accent square blinks like a terminal cursor */
  .pitch h1::after { animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .pitch h1::after { animation: none; } }
  .pitch p { margin: 18px 0 0; font-size: clamp(1.05rem, 2.4vw, 1.3rem); color: var(--ink); }
  .pitch .go { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .pitch .btn { height: 40px; padding: 0 16px; font-size: 15px; }

  .credit {
    position: absolute; right: clamp(16px, 5vw, 56px); bottom: 14px; padding: 4px 8px; border: 0; border-radius: 6px; background: var(--bg);
    color: var(--faint); font: 12px var(--mono); cursor: pointer;
  }
  .credit:hover { color: var(--ink); }
  .credit code { font: inherit; color: var(--f); }

  main { max-width: 880px; margin: 0 auto; padding: 0 16px; }
  section { padding: 56px 0 8px; }
  h2 { margin: 0 0 18px; font: 500 13px var(--mono); text-transform: uppercase; letter-spacing: 0.12em; color: var(--faint); }

  .taste { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 10px; }
  .taste a { display: grid; gap: 4px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); color: inherit; text-decoration: none; }
  .taste a:hover { border-color: var(--accent); }
  .taste .label { font-size: 13px; color: var(--muted); }
  .taste code { font: 14px/1.5 var(--mono); overflow-wrap: anywhere; }
  .taste .result { font: italic 14px var(--mono); color: var(--c); }
  .more { margin: 18px 0 0; }

  .install { margin: 0 0 14px; padding: 16px 18px; border-radius: 10px; background: var(--sunk); font: 14px/1.6 var(--mono); overflow-x: auto; }
  section p { color: var(--muted); }

  footer { max-width: 880px; margin: 48px auto 0; padding: 20px 16px 40px; border-top: 1px solid var(--line); font-size: 14px; }
  footer a { color: var(--faint); }
</style>
